{
  "name": "screenshot-redactor",
  "version": "0.1.0",
  "private": true,
  "description": "Find email addresses and phone numbers in a screenshot and export a flattened, redacted PNG in the browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/redactions.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
